# Copy to .env (git-ignored) and fill in. Never commit real keys.
# Gemini: comma-separated, tried in order with automatic fallback.
GEMINI_API_KEYS=
# Optional model order override:
# GUARDIAN_GEMINI_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-3.5-flash-lite,gemini-flash-lite-latest
# Optional Claude key (tried before Gemini when set):
# ANTHROPIC_API_KEY=
