# Copy to .env (git-ignored) and fill in. Never commit real keys.
# Gemini: comma-separated, tried in order with automatic fallback.
GEMINI_API_KEYS=
# Dedicated Gemini API key for LLM test generation & sandbox auto-mitigation:
GEMINI_API_FOR_TESTING=
# Optional model order override:
# GUARDIAN_GEMINI_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-3.5-flash-lite,gemini-flash-lite-latest
# Optional Claude key (tried before Gemini/Groq when set):
# ANTHROPIC_API_KEY=
# Cryptographic Merkle Baseline & Audit Ledger signing passphrase (keep secret, never commit):
GUARDIAN_SIGNING_KEY=

# Groq: add up to four keys from https://console.groq.com/keys.
# Keys are tried in order; rate-limit/auth failures rotate to the next key.
GROQ_API_KEYS=
# Or use numbered variables instead of the comma-separated value:
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# GROQ_API_KEY_4=
# Optional model order override:
# GUARDIAN_GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
